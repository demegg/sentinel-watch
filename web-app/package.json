{
  "name": "sentinelwatch-web",
  "version": "1.5.0-beta",
  "private": true,
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "predev": "node scripts/check-node.mjs",
    "dev": "NEXT_TEST_WASM=1 NEXT_TEST_WASM_DIR=$PWD/node_modules/@next/swc-wasm-nodejs next dev --webpack -H 0.0.0.0 -p 3100",
    "prebuild": "node scripts/check-node.mjs",
    "build": "next build",
    "build:local-wasm": "NEXT_TEST_WASM=1 NEXT_TEST_WASM_DIR=$PWD/node_modules/@next/swc-wasm-nodejs next build --webpack",
    "start": "next start -H 0.0.0.0 -p 3100",
    "lint": "eslint"
  },
  "dependencies": {
    "@googlemaps/js-api-loader": "^2.1.1",
    "@next/swc-wasm-nodejs": "^16.2.12",
    "clsx": "^2.1.1",
    "framer-motion": "^12.42.2",
    "hls.js": "^1.6.16",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.27.0",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-leaflet": "^5.0.0",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/google.maps": "^3.65.3",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9",
    "eslint-config-next": "^16.2.12",
    "tailwindcss": "^4",
    "typescript": "^5"
  }

# Sentinel Watch Beta — copy to .env.local and fill in values.
# Never commit .env.local.

# Windy Webcams API (server-only) — https://api.windy.com/webcams
WINDY_WEBCAM_API_KEY=

# Optional Google Maps (client-exposed if set — restrict key by HTTP referrer in Google Cloud)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

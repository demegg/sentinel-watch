# Sentinel Watch Beta — copy to .env.local and fill in values.
# Never commit .env.local.

# Windy Webcams API (server-only) — https://api.windy.com/webcams
WINDY_WEBCAM_API_KEY=

# Set to 1 only when a trusted reverse proxy overwrites X-Forwarded-For
# (do not enable on a bare Node process exposed to the internet).
TRUST_PROXY=

# Upstash Redis REST — shared rate limits across Vercel instances.
# Create a free DB at https://console.upstash.com → REST URL + token.
# Without these, the app falls back to per-instance in-memory limits.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

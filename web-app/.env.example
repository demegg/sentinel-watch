# Sentinel Watch Beta — copy to .env.local and fill in values.
# Never commit .env.local.

# Windy Webcams API (server-only) — https://api.windy.com/webcams
WINDY_WEBCAM_API_KEY=

# Optional Google Maps (bundled into the client). In Google Cloud Console:
# - Application restriction: HTTP referrers
# - Allow only your domains (e.g. https://your-app.vercel.app/* and http://localhost:3100/*)
# - API restriction: Maps JavaScript API (+ Street View / Map Tiles if used)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Set to 1 only when a trusted reverse proxy overwrites X-Forwarded-For
# (do not enable on a bare Node process exposed to the internet).
TRUST_PROXY=
